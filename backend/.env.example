PORT=5000
FLASK_DEBUG=1
# Gere um segredo forte: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=troque-este-segredo
# 7 dias em segundos
JWT_EXPIRES_IN=604800
CORS_ORIGINS=http://localhost:5173
# Local: SQLite. Supabase: postgresql+psycopg://postgres.<ref>:<senha>@<host>:5432/postgres (instale psycopg[binary])
DATABASE_URL=sqlite:///medflux.db
