# =============================================================================
# MedFlux backend - copie para .env e ajuste os valores. Nunca versione o .env.
# Gere segredos com: python -c "import secrets; print(secrets.token_urlsafe(48))"
# =============================================================================

# --- Aplicação ---------------------------------------------------------------
APP_ENV=development
APP_PORT=5000
LOG_LEVEL=INFO
# Origens permitidas no CORS (separe várias por vírgula)
FRONTEND_URL=http://localhost:5173

# --- MySQL (container) -------------------------------------------------------
MYSQL_ROOT_PASSWORD=troque-root-password
MYSQL_DATABASE=medflux
MYSQL_USER=medflux
MYSQL_PASSWORD=troque-medflux-password
# Porta exposta no host (mude se já houver um MySQL local na 3306)
MYSQL_HOST_PORT=3306

# --- MySQL (conexão do backend) - mesmos valores de MYSQL_* acima -------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=medflux
DB_PASSWORD=troque-medflux-password
DB_NAME=medflux

# --- MinIO -------------------------------------------------------------------
MINIO_ENDPOINT=localhost:9000
# Endpoint que o navegador enxerga, usado para assinar URLs pré-assinadas
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=medflux-minio
MINIO_SECRET_KEY=troque-minio-secret
MINIO_BUCKET=medflux-documents
MINIO_SECURE=false
PRESIGNED_URL_EXPIRE_MINUTES=60

# --- Qdrant ------------------------------------------------------------------
QDRANT_HOST=localhost
QDRANT_PORT=6333
EMBEDDING_DIM=384

# --- Redis (opcional: rate limit de login) -----------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900

# --- OpenRouter (vazio = fallback determinístico) ----------------------------
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_TIMEOUT=20

# --- Agentes: custom (cliente próprio) ou ag2 (framework AG2) ----------------
AGENT_RUNTIME=custom

# --- JWT ---------------------------------------------------------------------
JWT_SECRET_KEY=troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Seed --------------------------------------------------------------------
# Cria marina.santos@medflux.com / 123456 (ignorado quando APP_ENV=production)
SEED_DEMO_USER=true
# Administrador (necessário para POST /api/v1/vector/index-disease)
SEED_ADMIN_EMAIL=admin@medflux.com
SEED_ADMIN_PASSWORD=troque-admin-password
